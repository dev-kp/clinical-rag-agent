# Provider selection: "azure", "ollama", or "groq"
LLM_PROVIDER=groq
EMBEDDING_PROVIDER=ollama

# Azure OpenAI (only needed when LLM_PROVIDER=azure or EMBEDDING_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Ollama (local, default for dev/CI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=phi3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Groq (hosted, free tier, used as the real LLM before an Azure account exists)
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b

# Vector store selection: "pgvector" or "azure_search"
VECTOR_STORE=pgvector

# Postgres / pgvector
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clinical_rag

# Azure AI Search (only needed when VECTOR_STORE=azure_search)
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=clinical-rag-chunks

# LangSmith (optional tracing)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=clinical-rag-agent

# Agent loop guards
MAX_RETRIEVAL_ITERATIONS=3
RETRIEVAL_TOP_K=6
